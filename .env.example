# Copy to .env and fill in. Never commit .env.

# --- LLM provider (Hermes auto-detects from whichever key is set) ---
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Model choice lives in data/instances/<name>/config.yaml (model.default / provider / base_url).
# Local dev uses Ollama on the host: see README "Local model (Ollama)".

# --- Hermes API server (what your platform's UI/control plane talks to) ---
# Generate with: openssl rand -hex 32
API_SERVER_KEY=

# --- Hermes built-in dashboard (dev convenience only) ---
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# Pin the image. Move to a version tag / digest once things work.
HERMES_IMAGE=nousresearch/hermes-agent:latest
