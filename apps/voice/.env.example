# Copy to apps/voice/.env (git-ignored). Only needed for the phone line (phone.py).

# From https://console.twilio.com (Account Info). The auth token also signs/verifies webhooks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number, E.164, e.g. +15551234567
TWILIO_FROM_NUMBER=

# Public HTTPS host that reaches 127.0.0.1:7861 (Tailscale Funnel name, no https://)
PHONE_PUBLIC_HOST=your-machine.your-tailnet.ts.net
# Who may call Jarvis, and whom Jarvis may call. Comma-separated E.164, e.g. +27821234567
PHONE_ALLOWED_NUMBERS=
# PHONE_PORT=7861
